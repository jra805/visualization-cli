{
  "name": "codescape-cli",
  "version": "0.4.0",
  "description": "See your code as an 8-bit city, and the beginner mistakes it's hiding",
  "type": "module",
  "bin": {
    "codescape": "./dist/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "licenses"
  ],
  "keywords": [
    "code-quality",
    "beginner",
    "pixel-art",
    "visualization",
    "architecture",
    "diagram",
    "cli",
    "mermaid",
    "react",
    "nextjs",
    "python",
    "go",
    "java",
    "rust"
  ],
  "author": "jra805",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jra805/visualization-cli.git"
  },
  "homepage": "https://github.com/jra805/visualization-cli",
  "bugs": {
    "url": "https://github.com/jra805/visualization-cli/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "globby": "^14.0.2",
    "ora": "^8.1.0",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
